# Copy this file to .env.local and fill in real values.
# Select one provider. Never commit .env.local.
AI_PROVIDER=devin
# Devin v3 requires a cog_ key with UseDevinSessions and the org- ID.
DEVIN_API_KEY=cog_your_key_here
DEVIN_ORG_ID=org-your_org_id_here
# Hard cap per created Devin session in ACUs (1-20; default 2).
DEVIN_MAX_ACU=2

# To use OpenAI instead, set AI_PROVIDER=openai and configure these:
OPENAI_API_KEY=your_project_key_here
# Model with Responses API Structured Outputs support; photo mode also requires image input.
OPENAI_MODEL=gpt-4.1
